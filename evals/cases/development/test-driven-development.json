    {"type": "contains", "pattern": "Test-Driven Development", "name": "contains-tdd-title"},
    {"type": "section_exists", "pattern": "When to Use", "name": "has-when-to-use"},
    {"type": "anti_rat_table", "name": "has-anti-rat-table"},
    {"type": "frontmatter_field", "field": "version", "name": "has-version"},
    {"type": "code_block_count", "min": 1, "name": "has-code-examples"},
    {"type": "has_workflow_section", "name": "has-workflow"},
