{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://1ai-skills/references/skill-schema.json",
  "title": "1ai-skill",
  "description": "Schema for 1ai-skills SKILL.md frontmatter metadata",
  "type": "object",
  "required": [
    "name",
    "description",
    "domain"
  ],
  "recommended": [
    "tags",
    "version",
    "author",
    "license",
    "subdomain"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Kebab-case identifier for the skill"
    },
    "description": {
      "type": "string",
      "minLength": 50,
      "maxLength": 500,
      "description": "Human-readable description with trigger phrase ('Use when...')"
    },
    "domain": {
      "type": "string",
      "enum": [
        "agents", "automation", "content", "core", "cybersecurity",
        "data", "development", "devops", "finance", "financial",
        "integrations", "marketing", "mcp", "meta", "mindset",
        "operations", "productivity", "research", "sales", "trading"
      ],
      "description": "Primary domain category"
    },
    "subdomain": {
      "type": "string",
      "description": "More specific subdomain within the parent category"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Searchable tags for discovery"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Semantic version for the skill content"
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "description": "Original author or maintainer alias"
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier"
    },
    "persona": {
      "type": "object",
      "description": "AI persona for skill execution",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "expertise": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date the skill was created"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date the skill was last updated"
    },
    "see_also": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Related skill names for cross-reference"
    },
    "d3fend_techniques": {
      "type": "array",
      "items": { "type": "string" },
      "description": "MITRE D3FEND techniques (cybersecurity only)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "domain": { "const": "cybersecurity" } }
      },
      "then": {
        "recommended": [
          "version", "author", "subdomain", "d3fend_techniques"
        ]
      }
    }
  ]
}
